{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "paths": {
      "*": ["*", "*.native", "*.web"],
      "assets/*": ["src/assets/*"],
      "components/*": ["src/components/*"],
      "navigation/*": ["src/navigation/*"],
      "screens/*": ["src/screens/*"],
      "styles/*": ["src/styles/*"],
      "services/*": ["src/services/*"],
      "utils/*": ["src/utils/*"],
      "types/*": ["src/types/*"]
    },
    "resolvePackageJsonExports": true,
    "jsx": "react-native",
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
